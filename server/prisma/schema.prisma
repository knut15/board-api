// 커리큘럼 4.3 · 4.4 — docs/01-domain.md 의 필드 표를 그대로 옮긴 것이다.
// 스키마를 고치면 그 문서도 같이 고친다.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 부터 연결 주소는 스키마가 아니라 prisma.config.ts 에 둔다.
// 스키마는 "무엇이 있는가" 만 말하고, "어디에 붙는가" 는 설정이 말한다.
datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  // UNIQUE 를 DB 에 건다. 3단계에서는 findByEmail 로 매번 전부 훑어 막았는데,
  // 그 방식은 두 요청이 동시에 들어오면 둘 다 통과한다. 제약은 DB 가 걸어야 확실하다.
  email String @unique

  // 6.1 에서 평문 password 를 argon2 해시로 바꾸며 컬럼 이름도 함께 옮겼다.
  // 이름이 내용과 맞아야 한다 — password 라는 이름의 컬럼에 해시가 들어 있으면
  // 다음 사람이 평문인 줄 알고 비교한다.
  passwordHash String

  nickname  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  posts    Post[]
  comments Comment[]

  @@map("users")
}

model Post {
  id       String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid

  title String
  body  String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // 글쓴이를 지우는 엔드포인트가 없으므로 Restrict 로 둔다.
  // 글이 남아 있는 사람을 지우려 하면 DB 가 막는다 — 고아 글이 생기지 않는다.
  author   User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comments Comment[]

  // 7.6 — 목록의 정렬 키와 같은 모양으로 만든다. 방향까지 맞춰야 DB 가 인덱스를 거꾸로
  // 읽지 않고 그대로 따라간다. 이 인덱스가 없으면 1만 건을 전부 읽어 정렬한다(Seq Scan + Sort).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // 작성자 필터(7.5)와 외래키 조회를 위한 인덱스. PostgreSQL 은 FK 에 인덱스를 자동으로 만들지 않는다.
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @db.Uuid
  authorId String @db.Uuid

  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // 글이 지워지면 댓글도 같이 지운다. 3단계에서 removeByPostId 로 손수 하던 일을
  // DB 에 맡기는 것이다. 이유는 docs/06-postgres.md 4.3 절에 적어 뒀다.
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // 댓글 목록은 항상 postId 로 거른다. PostgreSQL 은 외래키에 인덱스를 자동으로 만들지 않는다 —
  // 제약과 인덱스는 다른 것이다. 없으면 댓글이 쌓일수록 목록 조회가 전체를 훑는다.
  @@index([postId])

  @@map("comments")
}
